<Window x:Class="Vox.App.TextReplacementsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Text replacements · Vox" Icon="Assets/vox.ico"
        Width="660" Height="680" MinWidth="560" MinHeight="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Text replacements" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="Teach Vox how you want words written. For example: open ai → OpenAI." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
      <TextBlock Text="Matches whole words or phrases, ignoring case. Your output keeps its exact spelling." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,16" />
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,7">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
      <TextBlock Text="When Vox hears" Style="{StaticResource MutedText}" />
      <TextBlock Grid.Column="1" Text="Write instead" Style="{StaticResource MutedText}" Margin="8,0,0,0" />
    </Grid>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="100">
      <ItemsControl x:Name="RulesList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
              <TextBox Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Word or phrase to replace" />
              <TextBox Grid.Column="1" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" AutomationProperties.Name="Replacement text" />
              <Button Grid.Column="2" Content="Remove" Click="RemoveRule" Tag="{Binding}" Margin="8,0,0,0" Padding="5" FontSize="11" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <StackPanel Grid.Row="3" Margin="0,8,0,18">
      <Button Content="+ Add rule" Click="AddRule" HorizontalAlignment="Left" />
      <TextBlock Text="A blank replacement removes the phrase. Changes apply after you save." Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Row="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
      <StackPanel>
        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="Try your rules" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Preview" Click="PreviewRules" Padding="10,6" FontSize="12" />
        </Grid>
        <TextBox x:Name="SampleInput" MinHeight="40" TextWrapping="Wrap" AutomationProperties.Name="Sample transcription" ToolTip="Type a sample transcription, then choose Preview" />
        <TextBox x:Name="SampleOutput" MinHeight="40" MaxHeight="90" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Margin="0,8,0,0" AutomationProperties.Name="Replacement preview" />
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="5" x:Name="ErrorText" Foreground="#FF9FAD" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
      <Button Content="Save replacements" Click="SaveRules" Style="{StaticResource AccentButton}" />
    </StackPanel>
  </Grid>
</Window>
